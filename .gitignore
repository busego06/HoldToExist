# This .gitignore file is for Unity projects

# =============== #
# Unity generated #
# =============== #
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
UserSettings/
sysinfo.txt

# Crash Reports
[Dd]ebug/

# =========== #
# OS-specific #
# =========== #
.DS_Store
Thumbs.db

# ============ #
# IDE-specific #
# ============ #
.vscode/
.idea/
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

# =============== #
# Visual Studio   #
# =============== #
ExportedObj/
.consulo/
*.unityproj
*.csproj
*.tmp
*.svd
*.suo
*.user
*.userprefs

# =============== #
# Rider           #
# =============== #
*.sln.iml

# ================= #
# Builds / Packages #
# ================= #
[Bb]uild/
[Bb]uilds/
[Pp]ackages/*-lock.json
*.apk
*.aab
*.unitypackage

# =============== #
# Asset meta data #
# =============== #
# (only ignore if the corresponding asset is ignored)
!/[Aa]ssets/**/*.meta

# ===================== #
# Unity Asset Store     #
# ===================== #
[Aa]ssets/AssetStoreTools*

# ===================== #
# JetBrains Rider cache #
# ===================== #
.idea/

# ================= #
# Auto-generated    #
# ================= #
*.g.cs
.vs/